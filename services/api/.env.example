PORT=8080
# Content: the YAML folder (loaded at start) — build output is used by the game, not the API
CONTENT_DIR=../../content
# Azure AI Speech (same region as the database). The key never leaves the server.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Anthropic: the live answer judge. Leave empty to run with the matcher only.
ANTHROPIC_API_KEY=
