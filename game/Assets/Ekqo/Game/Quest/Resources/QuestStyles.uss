/* Quest 1 screens. Loaded by QuestPlayer from Resources, so it never depends on scene
   references. All text uses the Advanced Text Generator, which shapes Myanmar script. */
Label { -unity-text-generator: advanced; white-space: normal; color: rgb(40, 30, 60); }

.layer      { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mixed      { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; flex-shrink: 1; }
.run--latin { margin: 0 6px; }
.run--script { padding-top: 6px; padding-bottom: 6px; }

/* Pixel-art look: thick dark outlines, small corners, cream boxes (matches PixelArt.txt colours:
   outline 1b1a2c, cream fffbe8, light ffe27a). */
.pixel-fit { -unity-background-scale-mode: scale-to-fit; }
.veil      { background-color: rgba(16, 16, 34, 0.82); }

/* Dialogue box at the bottom, under the world, so it never covers Ekqo. The speaker's name
   sits in a tab on its top edge. */
.bubble          { position: absolute; left: 13%; right: 13%; bottom: 3%; min-height: 128px; padding: 22px 30px 16px 30px;
                   border-radius: 8px; border-width: 6px; border-color: rgb(27, 26, 44);
                   background-color: rgb(255, 251, 232); align-items: flex-start; justify-content: center; }
.bubble__name    { position: absolute; top: -26px; left: 22px; padding: 2px 14px; border-radius: 6px; border-width: 4px;
                   border-color: rgb(27, 26, 44); background-color: rgb(255, 226, 122); }
.bubble__speaker { font-size: 20px; -unity-font-style: bold; color: rgb(27, 26, 44); }
.bubble__line    { justify-content: flex-start; }
.bubble__text    { font-size: 46px; -unity-text-align: middle-left; }
.bubble__support { font-size: 22px; color: rgb(110, 100, 130); margin-top: 4px; -unity-text-align: middle-left; }
.hidden          { display: none; }

/* Story caption for scenes */
.caption { position: absolute; left: 12%; right: 12%; top: 6%; font-size: 28px; color: rgb(255, 247, 214);
           -unity-text-align: middle-center; padding: 12px 20px; border-radius: 8px; border-width: 4px;
           border-color: rgb(27, 26, 44); background-color: rgba(27, 26, 44, 0.80); }
.title   { font-size: 44px; -unity-font-style: bold; color: rgb(255, 214, 102); -unity-text-align: middle-center; }

/* Round buttons in the corners */
.round        { position: absolute; width: 96px; height: 96px; border-radius: 12px; background-color: rgb(255, 226, 122);
                border-width: 5px; border-color: rgb(27, 26, 44); align-items: center; justify-content: center; }
.round:active { scale: 0.92 0.92; }
.round--next  { right: 3%; bottom: 4%; }
.round--hear  { left: 3%; bottom: 4%; width: 80px; height: 80px; background-color: rgb(168, 220, 255); }
.round__icon  { width: 60%; height: 60%; }
.round--hint  { left: 3%; bottom: 19%; width: 80px; height: 80px; background-color: rgb(255, 240, 190); }

.hint-toggle  { position: absolute; right: 2%; top: 2%; padding: 6px 14px; border-radius: 6px; font-size: 16px;
                border-width: 3px; border-color: rgb(27, 26, 44); background-color: rgba(27, 26, 44, 0.75); color: rgb(255, 247, 214); }
.stamp        { position: absolute; left: 1%; bottom: 0.5%; font-size: 12px; color: rgba(255, 247, 214, 0.45); }

/* Instruction to the child, above the choices */
.instruction  { position: absolute; left: 20%; right: 20%; top: 3%; font-size: 24px; color: rgb(255, 247, 214);
                -unity-text-align: middle-center; padding: 8px 16px; border-radius: 8px; border-width: 4px;
                border-color: rgb(27, 26, 44); background-color: rgba(27, 26, 44, 0.80); }

/* Choices: picture and phrase cards in two columns, left and right of Ekqo */
.choices      { position: absolute; left: 2%; right: 2%; top: 18%; bottom: 25%; flex-direction: row;
                justify-content: space-between; align-items: center; }
.choices__side { width: 30%; align-items: center; justify-content: center; }
.card         { width: 200px; margin: 8px 0; padding: 12px; border-radius: 8px; background-color: rgb(255, 251, 232);
                align-items: center; border-width: 6px; border-color: rgb(27, 26, 44); }
.card:active  { scale: 0.95 0.95; }
.card--right  { border-color: rgb(63, 155, 70); background-color: rgb(214, 245, 200); }
.card--wrong  { opacity: 0.45; }
.card--glow   { border-color: rgb(255, 179, 71); background-color: rgb(255, 240, 190); }
.card__picture { width: 130px; height: 120px; }
.card__text   { font-size: 34px; -unity-text-align: middle-center; }
.card__gloss  { font-size: 18px; color: rgb(120, 110, 140); }
.card--phrase { width: auto; min-width: 220px; padding: 22px 30px; }

/* Big word card while teaching (hear and echo) */
.word         { position: absolute; right: 3%; top: 18%; width: 28%; padding: 16px; border-radius: 8px;
                border-width: 6px; border-color: rgb(27, 26, 44); background-color: rgb(255, 251, 232); align-items: center; }
.word__picture { width: 170px; height: 150px; }
.word__text   { font-size: 54px; -unity-text-align: middle-center; }
.word__gloss  { font-size: 22px; color: rgb(120, 110, 140); }

/* Reward, discovery and end cards in the middle */
.panel        { position: absolute; left: 22%; right: 22%; top: 16%; padding: 26px; border-radius: 8px;
                border-width: 6px; border-color: rgb(27, 26, 44); background-color: rgb(255, 251, 232); align-items: center; }
.panel__icon  { width: 160px; height: 160px; }
.panel__title { font-size: 32px; -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 8px; }
.panel__text  { font-size: 22px; color: rgb(90, 80, 110); -unity-text-align: middle-center; margin-top: 6px; }
.panel__words { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 12px; }
.chip         { margin: 6px; padding: 8px 16px; border-radius: 6px; border-width: 3px; border-color: rgb(27, 26, 44);
                background-color: rgb(255, 236, 179); align-items: center; }
.chip__text   { font-size: 30px; }
.chip__gloss  { font-size: 15px; color: rgb(120, 110, 140); }
.button       { margin-top: 16px; padding: 14px 30px; border-radius: 8px; border-width: 5px; border-color: rgb(27, 26, 44);
                background-color: rgb(255, 226, 122); font-size: 24px; -unity-font-style: bold; }
.button:active { scale: 0.95 0.95; }
.button--quiet { background-color: rgba(0, 0, 0, 0); border-width: 0; font-size: 16px; color: rgb(140, 130, 160); margin-top: 6px; }

/* Grown-up hints (English) can be switched off with the button in the corner. */
.no-hints .hint { display: none; }

.subtitle           { font-size: 24px; color: rgb(255, 247, 214); -unity-text-align: middle-center; margin: 8px 0; }
.instruction__main  { font-size: 28px; color: rgb(255, 247, 214); -unity-text-align: middle-center; }
.instruction__hint  { font-size: 18px; color: rgba(255, 247, 214, 0.75); -unity-text-align: middle-center; }
